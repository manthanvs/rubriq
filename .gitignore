# Environment
.venv/
.env

# Secrets — the .example file is committed, the real one never is
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# The database. SQLite in WAL mode keeps two sidecar files beside it
# (-wal, -shm); none of the three belong in version control.
*.db
*.db-wal
*.db-shm
*.sqlite3

# Student uploads live outside version control
uploads/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
