# Environment
.venv/
.env

# Secrets — the .example file is committed, the real one never is
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# The database, and the graph checkpoint store beside it. SQLite in WAL mode
# keeps two sidecar files per database (-wal, -shm); none belong in version
# control. ai_checkpoints.db is deliberately separate from rubriq.db so a
# corrupt checkpoint can be deleted without touching a single mark (section 6.2).
*.db
*.db-wal
*.db-shm
*.sqlite3

# Student uploads live outside version control
uploads/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Word lock files, left behind while a .docx is open
~$*
