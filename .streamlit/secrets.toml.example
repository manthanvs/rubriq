# Copy to .streamlit/secrets.toml and fill in. That file is gitignored.

[database]
# Optional. Omit it and RubriQ uses a SQLite file at the repository root,
# which is the intended setup (decision #8) — there is no server to install
# and no credentials to manage. Set it only to put the file elsewhere.
# url = "sqlite:///rubriq.db"
echo_sql = false

[rubriq]
# Invariant #4: asserted server-side against the OIDC email claim. The `hd`
# hint below is a convenience for the Google consent screen, not the check.
allowed_email_domain = "pccoepune.org"

# Invariant #5: role is assigned from this list, never self-selected.
faculty_allowlist = [
    "guide@pccoepune.org",
]

# --- Phase 1: Google OIDC. Streamlit reads this [auth] section by name. ---
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "generate-a-long-random-string"
# client_id = ""
# client_secret = ""
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# client_kwargs = { hd = "pccoepune.org", prompt = "select_account" }

# --- Phase 5: LLM provider (decision #4 — Gemini or Groq). ---
#
# Optional. Without it, AI evaluation is unavailable and says so; manual
# scoring, late penalties, the review grid and both exports are unaffected
# (invariant #10). Install the matching SDK from requirements.txt.
# [llm]
# provider = "gemini"   # or "groq"
# api_key = ""
# model = "gemini-3.6-flash"   # optional; Google retires models on its own
#                              # schedule, so this is config, not a constant
