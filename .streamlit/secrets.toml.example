# Copy to .streamlit/secrets.toml and fill in. That file is gitignored.

[database]
# Optional. Omit it and RubriQ uses a SQLite file at the repository root,
# which is the intended setup (decision #8) — there is no server to install
# and no credentials to manage. Set it only to put the file elsewhere.
# url = "sqlite:///rubriq.db"
echo_sql = false

[rubriq]
# Invariant #4: asserted server-side against the OIDC email claim. The `hd`
# hint below is a convenience for the Google consent screen, not the check.
allowed_email_domain = "pccoepune.org"

# Invariant #5: role is assigned from this list, never self-selected.
faculty_allowlist = [
    "guide@pccoepune.org",
]

# --- Phase 1: Google OIDC. Streamlit reads this [auth] section by name. ---
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "generate-a-long-random-string"
# client_id = ""
# client_secret = ""
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# client_kwargs = { hd = "pccoepune.org", prompt = "select_account" }

# --- Phase 5: LLM provider (decision #4 — Gemini or Groq). ---
#
# Optional. Without it, AI evaluation is unavailable and says so; manual
# scoring, late penalties, the review grid and both exports are unaffected
# (invariant #10). Install the matching SDK from requirements.txt.
# [llm]
# provider = "gemini"   # or "groq", or "openrouter"
# api_key = ""
# model = "gemini-3.6-flash"   # optional; Google retires models on its own
#                              # schedule, so this is config, not a constant
#
# Two OpenAI-shaped gateways are also supported. Choose a model that
# supports `response_format`, so §6.5's JSON-only contract is enforced by the
# API rather than merely requested by the prompt.
#
# OpenRouter — one key, many vendors; `:free` marks the no-cost variants:
# [llm]
# provider = "openrouter"
# api_key = "sk-or-v1-..."
# model = "nvidia/nemotron-3-super-120b-a12b:free"
#
# NVIDIA's own endpoint — same weights, no `:free` suffix on the model id:
# [llm]
# provider = "nvidia"
# api_key = "nvapi-..."
# model = "nvidia/nemotron-3-super-120b-a12b"
#
# `nemotron-3-ultra-550b-a55b` is larger and also free on OpenRouter, but
# advertises no `response_format`. It still works, falling back on the prompt
# and the repair loop — quietly, since a parse failure costs a criterion
# rather than raising. Check any model before choosing it:
#   curl -s https://openrouter.ai/api/v1/models | jq '.data[]
#     | select(.id|test("free")) | {id, supported_parameters}'

# --- Deployment only. Leave this out on a development machine. ---
#
# A host like Streamlit Community Cloud runs `streamlit run app/main.py` and
# nothing else — there is no shell, so `make seed` never happens and the app
# would start against a database that does not exist.
#
# Setting this true lets the app migrate itself on first boot, and seed the
# demo cohort if nobody exists yet. It refuses to touch a database that
# already holds a user, so it cannot overwrite real marks even when left on
# by accident — but the default is off, because that guard should not be the
# only thing standing between a demo seed and somebody's grades.
#
# The seeded subject is owned by the first address in faculty_allowlist above.
# [deploy]
# bootstrap = true
