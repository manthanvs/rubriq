# Used by Alembic and pytest, which run outside Streamlit and have no
# st.secrets to read. The app itself reads .streamlit/secrets.toml instead.
#
# Everything here is optional. With no .env at all, RubriQ uses a SQLite file
# at the repository root — see core.config.DEFAULT_DATABASE_URL.
#
# Copy to .env and edit. Never commit .env.

# Override only if you want the database somewhere else, or a throwaway copy.
# RUBRIQ_DATABASE_URL=sqlite:///rubriq.db

# Optional
# RUBRIQ_EMAIL_DOMAIN=pccoepune.org
# RUBRIQ_FACULTY_ALLOWLIST=guide@pccoepune.org
# RUBRIQ_ECHO_SQL=false
